<Window x:Class="HardwareCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HardwareCenter.Controls"
        xmlns:v="clr-namespace:HardwareCenter.Views"
        xmlns:vm="clr-namespace:HardwareCenter.ViewModels"
        Title="HardwareCenter"
        Width="1240" Height="820" MinWidth="980" MinHeight="640"
        Background="{StaticResource B.Bg}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Topmost="{Binding SettingsPage.AlwaysOnTop}">

    <!-- The top 50 px behave as the title bar: drag to move, double-click to maximize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardVM}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicePageVM}">
            <v:DevicePageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThermalsPageVM}">
            <v:ThermalsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsPageVM}">
            <v:SensorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemPageVM}">
            <v:SystemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsVM}">
            <v:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource B.Bg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Navigation rail ================= -->
            <Border Background="{StaticResource B.Rail}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,0,16">
                        <c:ArcGauge Width="26" Height="23" Value="0.7" Color="{StaticResource C.Blue}" Thickness="3.6" VerticalAlignment="Center" />
                        <TextBlock Text="HardwareCenter" FontFamily="{StaticResource Font.Display}" FontSize="15.5" FontWeight="SemiBold"
                                   Margin="11,0,0,1" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.Muted}" Margin="8,3,0,0" VerticalAlignment="Center"
                                   ToolTip="Installed version" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,12">
                        <RadioButton Style="{StaticResource NavRadio}" Content="{Binding SettingsNav}"
                                     IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}" />
                        <Border Margin="3,10,3,0" Padding="11,8" CornerRadius="9" Background="{StaticResource B.Inset}"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding AccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AccessLabel}" Style="{StaticResource T.Muted}" Foreground="{StaticResource B.Text2}"
                                           Margin="9,0,0,1" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox Style="{StaticResource NavList}" Margin="10,0" ItemsSource="{Binding Nav}"
                             SelectedItem="{Binding SelectedListItem}" AutomationProperties.Name="Pages" />
                </DockPanel>
            </Border>

            <!-- ================= Content ================= -->
            <Grid x:Name="ContentGrid" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource T.PageTitle}" Margin="28,0,160,9" VerticalAlignment="Bottom"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Btn.Caption}" Content="{StaticResource Caption.Minimize}" Click="OnMinimize"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Caption}" Content="{StaticResource Caption.Maximize}"
                            Click="OnMaximizeRestore" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
                    <Button Style="{StaticResource Btn.CaptionClose}" Content="{StaticResource Caption.Close}" Click="OnClose"
                            ToolTip="Close" AutomationProperties.Name="Close" />
                </StackPanel>

                <!-- Why some sensors are missing, with the one action that fixes it. -->
                <Border Grid.Row="1" Margin="28,2,28,12" Padding="14,10,8,10" CornerRadius="10"
                        Background="{StaticResource B.WarningTint}" BorderBrush="#33FAB219" BorderThickness="1"
                        Visibility="{Binding ShowBanner, Converter={StaticResource VisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Icon Width="17" Height="17" Data="{StaticResource Icon.Shield}" Foreground="{StaticResource B.Warning}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0,12,1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5">
                            <Run Text="{Binding Banner.Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run
                                 Text="{Binding Banner.Message, Mode=OneWay}" Foreground="{StaticResource B.Text2}" />
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="{Binding Banner.ActionText}"
                                Command="{Binding Banner.Action}" VerticalAlignment="Center"
                                Visibility="{Binding Banner.HasAction, Converter={StaticResource VisibilityConverter}}" />
                        <Button Grid.Column="3" Style="{StaticResource Btn.Ghost}" Command="{Binding Banner.DismissCommand}"
                                Padding="7" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                            <c:Icon Width="13" Height="13" Data="{StaticResource Icon.Close}" StrokeThickness="2.2" />
                        </Button>
                    </Grid>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>

                <!-- Shown until the first readings arrive. -->
                <Border x:Name="LoadingOverlay" Grid.Row="2" Background="{StaticResource B.Bg}"
                        Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
                        <!-- Spun from code so the animation can be stopped outright once loading ends. -->
                        <Path Width="30" Height="30" Stroke="{StaticResource B.Blue}" StrokeThickness="3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="M15 3 a12 12 0 0 1 12 12" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" />
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="Reading sensors…" Style="{StaticResource T.Label}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- The sensor library failed to start; Windows-level readings are still shown. -->
                <Border Grid.Row="2" VerticalAlignment="Bottom" Margin="28,0,28,16" Padding="14,10" CornerRadius="10"
                        Background="{StaticResource B.Raised}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                        Visibility="{Binding StartupError, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="{Binding StartupError}" Style="{StaticResource T.Body}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
