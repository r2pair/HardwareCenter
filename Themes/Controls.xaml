<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:HardwareCenter.Controls"
                    xmlns:vm="clr-namespace:HardwareCenter.ViewModels">

    <c:IconConverter x:Key="IconConverter" />
    <c:VisibilityConverter x:Key="VisibilityConverter" />
    <c:ColorBrushConverter x:Key="ColorBrushConverter" />
    <c:ThreadLabelConverter x:Key="ThreadLabelConverter" />

    <!-- ===================== Text ===================== -->

    <Style x:Key="T.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <Style x:Key="T.DeviceTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Section label above a list of rows. -->
    <Style x:Key="T.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
    </Style>

    <!-- Values in a column: tabular figures so digits line up row to row. -->
    <Style x:Key="T.RowValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- ===================== Surfaces ===================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,15,18,16" />
    </Style>

    <!-- Icon on a tinted rounded square. -->
    <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource B.Selected}" />
    </Style>

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{StaticResource B.Blue}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Scrolling ===================== -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="#2EFFFFFF" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#55FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#70FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!-- Tag carries the hover background so variants only change setters, not the template. -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Raised}" />
        <Setter Property="Tag" Value="{StaticResource B.RaisedHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7,14,8" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource B.Blue}" />
        <Setter Property="Tag" Value="{StaticResource B.BlueHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Tag" Value="{StaticResource B.Selected}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,6,10,7" />
    </Style>

    <!-- Window caption buttons: Content is the glyph geometry. -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Tag" Value="{StaticResource B.Selected}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <Path Width="10" Height="10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Setter Property="Tag" Value="{StaticResource B.CloseHover}" />
    </Style>

    <!-- ===================== Navigation ===================== -->

    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:Icon Width="18" Height="18" Data="{Binding IconKey, Converter={StaticResource IconConverter}}" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Margin="12,0,0,1" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="11.5" Foreground="{StaticResource B.Text3}"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <Style x:Key="NavItemContainer" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1" Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource B.Blue}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" />
                        <ContentPresenter Margin="13,9,11,9" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Selected}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItemContainer}" />
        <Setter Property="ItemTemplate" Value="{StaticResource NavItemTemplate}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A navigation entry that lives outside the list (Settings, pinned to the bottom). -->
    <Style x:Key="NavRadio" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content.Title, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ContentTemplate" Value="{StaticResource NavItemTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="0,1" Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource B.Blue}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" />
                        <ContentPresenter Margin="13,9,11,9" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Selected}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Inputs ===================== -->

    <!-- A labelled on/off switch: content on the left, switch on the right. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Margin="20,0,0,0"
                                Background="{StaticResource B.Raised}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" Fill="{StaticResource B.Text2}" HorizontalAlignment="Left" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource B.Blue}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Text3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One option of a segmented control. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="12,5,12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.RaisedHover}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="12,5,12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.RaisedHover}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The well a segmented control sits in. -->
    <Style x:Key="SegmentWell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Inset}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{StaticResource B.Inset}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Blue}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="32,7,30,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <!-- TextBox applies its own Padding to this host; adding it here would double it. -->
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource B.Raised}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                            CornerRadius="7" Padding="10,6,10,7" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Shared data templates ===================== -->

    <!-- State marker: an icon and a word, never colour alone. -->
    <DataTemplate x:Key="AlertPill">
        <Border CornerRadius="9" Padding="6,1,8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                Background="{Binding MeterColor, Converter={StaticResource ColorBrushConverter}, ConverterParameter=0.16}">
            <StackPanel Orientation="Horizontal">
                <c:Icon Width="11" Height="11" Data="{StaticResource Icon.Warning}" StrokeThickness="2.2" VerticalAlignment="Center"
                        Foreground="{Binding MeterColor, Converter={StaticResource ColorBrushConverter}}" />
                <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"
                           Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Tooltip listing a sensor's observed range. -->
    <DataTemplate x:Key="SensorTip" DataType="{x:Type vm:SensorVM}">
        <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource B.Text2}" Margin="0,3,0,0">
                <Run Text="Min" /> <Run Text="{Binding MinText, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                <Run Text="   Max" /> <Run Text="{Binding MaxText, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- A sensor inside a group card: name, meter where the kind has a scale, value. -->
    <DataTemplate x:Key="SensorRow" DataType="{x:Type vm:SensorVM}">
        <Grid MinHeight="29" Background="Transparent" ToolTipService.InitialShowDelay="350">
            <Grid.ToolTip>
                <ToolTip Content="{Binding}" ContentTemplate="{StaticResource SensorTip}" />
            </Grid.ToolTip>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AlertPill}" Focusable="False"
                            Visibility="{Binding IsAlert, Converter={StaticResource VisibilityConverter}}" Margin="8,0,0,0" />
            <c:MeterBar Grid.Column="2" Width="52" Value="{Binding Fraction}" Color="{Binding MeterColor}" VerticalAlignment="Center"
                        Margin="10,0,0,0" Visibility="{Binding HasMeter, Converter={StaticResource VisibilityConverter}}" />
            <TextBlock Grid.Column="3" Text="{Binding ValueText}" Style="{StaticResource T.RowValue}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- A sensor under a friendlier label with a full-width meter (overview lists). -->
    <DataTemplate x:Key="LabeledMeterRow" DataType="{x:Type vm:LabeledSensor}">
        <Grid Height="31" Background="Transparent" ToolTipService.InitialShowDelay="350">
            <Grid.ToolTip>
                <ToolTip Content="{Binding Sensor}" ContentTemplate="{StaticResource SensorTip}" />
            </Grid.ToolTip>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="Auto" MinWidth="62" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            <c:MeterBar Grid.Column="1" Value="{Binding Sensor.Fraction}" Color="{Binding Sensor.MeterColor}" VerticalAlignment="Center" Margin="12,0,4,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ContentControl Content="{Binding Sensor}" ContentTemplate="{StaticResource AlertPill}" Focusable="False" Margin="8,0,0,0"
                                Visibility="{Binding Sensor.IsAlert, Converter={StaticResource VisibilityConverter}}" />
                <TextBlock Text="{Binding Sensor.CompactText}" Style="{StaticResource T.RowValue}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- A fan: speed, plus its duty cycle as a meter when the device reports one. -->
    <DataTemplate x:Key="FanRowTemplate" DataType="{x:Type vm:FanRow}">
        <Grid Height="31" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="Auto" MinWidth="76" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Margin="12,0,4,0" Visibility="{Binding HasControl, Converter={StaticResource VisibilityConverter}}"
                  ToolTip="{Binding Control.ValueText}" Background="Transparent">
                <c:MeterBar Value="{Binding Control.Fraction, FallbackValue=0}" Color="{StaticResource C.Slate}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Column="2" Text="{Binding Speed.ValueText}" Style="{StaticResource T.RowValue}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- A headline figure in its own card. -->
    <DataTemplate x:Key="StatTile" DataType="{x:Type vm:StatVM}">
        <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,12,16,14" ToolTip="{Binding Hint}">
            <StackPanel>
                <DockPanel>
                    <c:Icon DockPanel.Dock="Right" Width="14" Height="14" Data="{StaticResource Icon.Warning}" StrokeThickness="2"
                            Foreground="{Binding Color, Converter={StaticResource ColorBrushConverter}}"
                            Visibility="{Binding IsAlert, Converter={StaticResource VisibilityConverter}}" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" />
                </DockPanel>
                <TextBlock Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Text, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="25" FontWeight="SemiBold"
                         Foreground="{StaticResource B.Text}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" FontSize="12.5"
                         Foreground="{StaticResource B.Text2}" />
                </TextBlock>
                <c:MeterBar Value="{Binding Fraction}" Color="{Binding Color}" Margin="0,9,0,0"
                            Visibility="{Binding HasMeter, Converter={StaticResource VisibilityConverter}}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" Margin="0,7,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource VisibilityConverter}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A history chart in its own card. A legend appears only when there are two series. -->
    <DataTemplate x:Key="ChartCard" DataType="{x:Type vm:ChartVM}">
        <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,12,12,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="{Binding IsDual, Converter={StaticResource VisibilityConverter}}">
                        <Ellipse Width="8" Height="8" Fill="{Binding BrushA}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LabelA}" Style="{StaticResource T.Muted}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{Binding BrushB}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LabelB}" Style="{StaticResource T.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Title}" />
                </DockPanel>
                <c:TrendChart Height="150" ShowAxis="True" WindowSeconds="300"
                              Source="{Binding A}" Source2="{Binding B}" Stroke="{Binding ColorA}" Stroke2="{Binding ColorB}"
                              Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- A sensor group ("Temperatures") as a card of rows. -->
    <DataTemplate x:Key="SensorGroupCard" DataType="{x:Type vm:SensorGroupVM}">
        <Border Style="{StaticResource Card}" Padding="18,13,18,10">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Title}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Sensors}" ItemTemplate="{StaticResource SensorRow}" Focusable="False" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
