<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        One dark theme. Surfaces step up in lightness from the window plane to raised elements.

        Data colours follow two rules:
          * Cool hues identify a component everywhere it appears: CPU blue, GPU aqua, memory violet,
            storage magenta. Devices without their own hue use neutral slate.
          * Warm hues are reserved for state: amber means warning, red means critical.
        A chart with two series (read/write, download/upload) uses blue then orange, a pair chosen
        to stay distinguishable under colour-vision deficiency.
    -->

    <!-- Surfaces -->
    <Color x:Key="C.Bg">#0B0D11</Color>
    <Color x:Key="C.Rail">#0E1015</Color>
    <Color x:Key="C.Card">#13161C</Color>
    <Color x:Key="C.Raised">#1B1F28</Color>
    <Color x:Key="C.RaisedHover">#242935</Color>
    <Color x:Key="C.Inset">#0E1116</Color>
    <Color x:Key="C.Border">#12FFFFFF</Color>
    <Color x:Key="C.BorderStrong">#26FFFFFF</Color>
    <Color x:Key="C.Grid">#11FFFFFF</Color>
    <Color x:Key="C.Hover">#0DFFFFFF</Color>
    <Color x:Key="C.Selected">#17FFFFFF</Color>

    <!-- Ink -->
    <Color x:Key="C.Text">#F1F3F7</Color>
    <Color x:Key="C.Text2">#AAB1BE</Color>
    <Color x:Key="C.Text3">#7C8492</Color>

    <!-- Identity -->
    <Color x:Key="C.Blue">#3987E5</Color>
    <Color x:Key="C.BlueHover">#4E97EE</Color>
    <Color x:Key="C.BluePressed">#2F76CC</Color>
    <Color x:Key="C.Orange">#D95926</Color>
    <Color x:Key="C.Aqua">#199E70</Color>
    <Color x:Key="C.Violet">#9085E9</Color>
    <Color x:Key="C.Magenta">#D55181</Color>
    <Color x:Key="C.Slate">#8E99AB</Color>

    <!-- State -->
    <Color x:Key="C.Good">#0CA30C</Color>
    <Color x:Key="C.Warning">#FAB219</Color>
    <Color x:Key="C.Critical">#D03B3B</Color>
    <Color x:Key="C.CloseHover">#C42B1C</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="B.Rail" Color="{StaticResource C.Rail}" />
    <SolidColorBrush x:Key="B.Card" Color="{StaticResource C.Card}" />
    <SolidColorBrush x:Key="B.Raised" Color="{StaticResource C.Raised}" />
    <SolidColorBrush x:Key="B.RaisedHover" Color="{StaticResource C.RaisedHover}" />
    <SolidColorBrush x:Key="B.Inset" Color="{StaticResource C.Inset}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Grid" Color="{StaticResource C.Grid}" />
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="B.Selected" Color="{StaticResource C.Selected}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Text2" Color="{StaticResource C.Text2}" />
    <SolidColorBrush x:Key="B.Text3" Color="{StaticResource C.Text3}" />
    <SolidColorBrush x:Key="B.Blue" Color="{StaticResource C.Blue}" />
    <SolidColorBrush x:Key="B.BlueHover" Color="{StaticResource C.BlueHover}" />
    <SolidColorBrush x:Key="B.BluePressed" Color="{StaticResource C.BluePressed}" />
    <SolidColorBrush x:Key="B.Orange" Color="{StaticResource C.Orange}" />
    <SolidColorBrush x:Key="B.Aqua" Color="{StaticResource C.Aqua}" />
    <SolidColorBrush x:Key="B.Slate" Color="{StaticResource C.Slate}" />
    <SolidColorBrush x:Key="B.Good" Color="{StaticResource C.Good}" />
    <SolidColorBrush x:Key="B.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="B.WarningTint" Color="{StaticResource C.Warning}" Opacity="0.13" />
    <SolidColorBrush x:Key="B.Critical" Color="{StaticResource C.Critical}" />
    <SolidColorBrush x:Key="B.CloseHover" Color="{StaticResource C.CloseHover}" />

    <!-- Segoe UI Variable ships with Windows 11; Segoe UI covers Windows 10. -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

</ResourceDictionary>
