<UserControl x:Class="HardwareCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HardwareCenter.Controls"
             xmlns:vm="clr-namespace:HardwareCenter.ViewModels">

    <UserControl.Resources>

        <!-- One figure under a headline gauge. -->
        <DataTemplate x:Key="HeroStat" DataType="{x:Type vm:StatVM}">
            <StackPanel HorizontalAlignment="Center" ToolTip="{Binding Hint}" Background="Transparent">
                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                    <c:Icon Width="12" Height="12" Data="{StaticResource Icon.Warning}" StrokeThickness="2.2" Margin="0,1,5,0" VerticalAlignment="Center"
                            Foreground="{Binding Color, Converter={StaticResource ColorBrushConverter}}"
                            Visibility="{Binding IsAlert, Converter={StaticResource VisibilityConverter}}" />
                    <TextBlock>
                        <Run Text="{Binding Text, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" /><Run
                             Text=" " FontSize="6" /><Run Text="{Binding Unit, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource B.Text2}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Processor, graphics and memory: a gauge, three figures and two minutes of history. -->
        <DataTemplate x:Key="HeroTile" DataType="{x:Type vm:HeroTileVM}">
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,15,18,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconChip}" Background="{Binding AccentTint}">
                            <c:Icon Width="18" Height="18" Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                                    Foreground="{Binding AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Title}" />
                            <TextBlock Text="{Binding Device}" Style="{StaticResource T.Muted}" Margin="0,1,0,0" ToolTip="{Binding Device}" />
                        </StackPanel>
                    </Grid>

                    <Grid Width="176" Height="150" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <c:ArcGauge Value="{Binding Primary.Fraction}" Color="{Binding Primary.Color}" Thickness="9" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock HorizontalAlignment="Center">
                                <Run Text="{Binding Primary.Text, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="42"
                                     FontWeight="SemiBold" Foreground="{StaticResource B.Text}" /><Run
                                     Text="{Binding Primary.Unit, Mode=OneWay}" FontSize="18" Foreground="{StaticResource B.Text2}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Primary.Label}" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource HeroStat}" Focusable="False" Margin="-8,2,-8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <c:TrendChart Height="42" Margin="-8,12,-8,0" Source="{Binding Trend}" Stroke="{Binding AccentColor}"
                                  Minimum="0" Maximum="100" WindowSeconds="120" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Card heading: icon chip and title. -->
        <Style x:Key="CardHeading" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="28,4,18,28">

            <ItemsControl ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource HeroTile}" Focusable="False" Margin="-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <c:CardGrid MinColumnWidth="340" MaxColumns="2" Gap="16" Margin="0,16,0,0">

                <!-- Temperatures -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeading}">
                            <c:Icon Width="16" Height="16" Data="{StaticResource Icon.Thermometer}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock Text="Temperatures" Style="{StaticResource T.Title}" Margin="9,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Temperatures}" ItemTemplate="{StaticResource LabeledMeterRow}" Focusable="False" />
                        <TextBlock Text="{Binding SensorNote}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                                   Visibility="{Binding SensorNote, Converter={StaticResource VisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Fans -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeading}">
                            <c:Icon Width="16" Height="16" Data="{StaticResource Icon.Fan}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock Text="Fans" Style="{StaticResource T.Title}" Margin="9,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Fans}" ItemTemplate="{StaticResource FanRowTemplate}" Focusable="False" />
                        <TextBlock Text="No fan speeds are being reported." Style="{StaticResource T.Label}" Margin="0,4,0,0"
                                   Visibility="{Binding HasFans, Converter={StaticResource VisibilityConverter}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding SensorNote}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                                   Visibility="{Binding SensorNote, Converter={StaticResource VisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasDrives, Converter={StaticResource VisibilityConverter}}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeading}">
                            <c:Icon Width="16" Height="16" Data="{StaticResource Icon.Storage}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock Text="Storage" Style="{StaticResource T.Title}" Margin="9,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DriveRow}">
                                    <StackPanel Margin="0,6,0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Temperature.CompactText}" Style="{StaticResource T.RowValue}"
                                                       Margin="10,0,0,0" ToolTip="Drive temperature" />
                                            <TextBlock Text="{Binding Hardware.Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <c:MeterBar Margin="0,9,0,7" Value="{Binding Used.Fraction, FallbackValue=0}"
                                                    Color="{Binding Used.MeterColor, FallbackValue={StaticResource C.Magenta}}" />
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                                <c:Icon Width="11" Height="11" Data="{StaticResource Icon.Down}" StrokeThickness="2.2"
                                                        Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" ToolTip="Read rate" />
                                                <TextBlock Text="{Binding Read.ValueText}" Style="{StaticResource T.Muted}" Foreground="{StaticResource B.Text2}"
                                                           Typography.NumeralAlignment="Tabular" Margin="4,0,12,0" />
                                                <c:Icon Width="11" Height="11" Data="{StaticResource Icon.Up}" StrokeThickness="2.2"
                                                        Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" ToolTip="Write rate" />
                                                <TextBlock Text="{Binding Write.ValueText}" Style="{StaticResource T.Muted}" Foreground="{StaticResource B.Text2}"
                                                           Typography.NumeralAlignment="Tabular" Margin="4,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" />
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Style="{StaticResource Card}" Padding="18,15,14,10">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeading}">
                            <c:Icon Width="16" Height="16" Data="{StaticResource Icon.Network}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Network.Detail}" Style="{StaticResource T.Muted}" Margin="10,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Title}" Margin="9,0,0,0">
                                <Run Text="Network" /><Run Text="   " /><Run Text="{Binding Network.Name, Mode=OneWay}" FontWeight="Normal"
                                     Foreground="{StaticResource B.Text2}" FontSize="12.5" />
                            </TextBlock>
                        </DockPanel>
                        <UniformGrid Rows="1" Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Network.DownloadBrush}" VerticalAlignment="Center" Margin="0,3,8,0" />
                                <StackPanel>
                                    <TextBlock Text="Download" Style="{StaticResource T.Muted}" />
                                    <TextBlock>
                                        <Run Text="{Binding Network.Download.Text, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="21"
                                             FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Network.Download.Unit, Mode=OneWay}"
                                             FontSize="12" Foreground="{StaticResource B.Text2}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Network.UploadBrush}" VerticalAlignment="Center" Margin="0,3,8,0" />
                                <StackPanel>
                                    <TextBlock Text="Upload" Style="{StaticResource T.Muted}" />
                                    <TextBlock>
                                        <Run Text="{Binding Network.Upload.Text, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="21"
                                             FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Network.Upload.Unit, Mode=OneWay}"
                                             FontSize="12" Foreground="{StaticResource B.Text2}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                        <c:TrendChart Height="118" ShowAxis="True" WindowSeconds="120"
                                      Source="{Binding Network.Chart.A}" Source2="{Binding Network.Chart.B}"
                                      Stroke="{StaticResource C.Blue}" Stroke2="{StaticResource C.Orange}" />
                    </StackPanel>
                </Border>

            </c:CardGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
