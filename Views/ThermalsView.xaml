<UserControl x:Class="HardwareCenter.Views.ThermalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HardwareCenter.Controls"
             xmlns:vm="clr-namespace:HardwareCenter.ViewModels">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="28,4,18,28">

            <!-- Hottest reading and the CPU/GPU history side by side -->
            <Grid Margin="0,0,0,16" Visibility="{Binding HasTemperatures, Converter={StaticResource VisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14,18,16">
                    <StackPanel VerticalAlignment="Center" DataContext="{Binding Hottest}">
                        <DockPanel>
                            <c:Icon Width="16" Height="16" Data="{StaticResource Icon.Thermometer}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Title}" Margin="9,0,0,0" />
                        </DockPanel>
                        <TextBlock Margin="0,14,0,0">
                            <Run Text="{Binding Text, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="46" FontWeight="SemiBold" /><Run
                                 Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" FontSize="18" Foreground="{StaticResource B.Text2}" />
                        </TextBlock>
                        <c:MeterBar Value="{Binding Fraction}" Color="{Binding Color}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Label}" Margin="0,11,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding Chart}" ContentTemplate="{StaticResource ChartCard}" Focusable="False" Margin="2,0,-6,0"
                                Visibility="{Binding Chart, Converter={StaticResource VisibilityConverter}}" />
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,12"
                    Visibility="{Binding Note, Converter={StaticResource VisibilityConverter}}">
                <DockPanel>
                    <c:Icon Width="16" Height="16" Data="{StaticResource Icon.Info}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource T.Body}" Margin="11,0,0,0" />
                </DockPanel>
            </Border>

            <!-- Temperatures, one card per device -->
            <TextBlock Text="TEMPERATURES" Style="{StaticResource T.Section}" Margin="2,2,0,10"
                       Visibility="{Binding HasTemperatures, Converter={StaticResource VisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinColumnWidth="320" MaxColumns="3" Gap="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThermalGroupVM}">
                        <Border Style="{StaticResource Card}" Padding="18,13,18,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <c:Icon Width="15" Height="15" Data="{Binding Hardware.IconKey, Converter={StaticResource IconConverter}}"
                                            Foreground="{Binding Hardware.AccentColor, Converter={StaticResource ColorBrushConverter}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Hardware.Name}" Style="{StaticResource T.Title}" Margin="9,0,0,0" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Sensors}" ItemTemplate="{StaticResource SensorRow}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fans -->
            <TextBlock Text="FANS" Style="{StaticResource T.Section}" Margin="2,22,0,10" />
            <Border Style="{StaticResource Card}" Padding="18,10,18,10">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Fans}" ItemTemplate="{StaticResource FanRowTemplate}" Focusable="False" />
                    <TextBlock Text="No fan speeds are being reported." Style="{StaticResource T.Label}" Margin="0,4"
                               Visibility="{Binding HasFans, Converter={StaticResource VisibilityConverter}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
