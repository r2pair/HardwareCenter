<UserControl x:Class="HardwareCenter.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HardwareCenter.Controls"
             xmlns:vm="clr-namespace:HardwareCenter.ViewModels">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <c:WidthCap>
        <StackPanel Margin="28,4,18,28">

            <TextBlock Text="Reading system information…" Style="{StaticResource T.Body}" Margin="0,8,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}" />

            <!-- One card per category; each card lists its devices with their facts. -->
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinColumnWidth="360" MaxColumns="3" Gap="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InfoSection}">
                        <Border Style="{StaticResource Card}" Padding="18,14,18,12">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <DockPanel Margin="0,0,0,8">
                                    <Border Style="{StaticResource IconChip}" Width="28" Height="28" CornerRadius="8">
                                        <c:Icon Width="15" Height="15" Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                                                Foreground="{StaticResource B.Text2}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Title}" FontSize="14" Margin="11,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:InfoBlock}">
                                            <StackPanel Margin="0,4,0,6">
                                                <TextBlock Text="{Binding Heading}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,3"
                                                           Visibility="{Binding HasHeading, Converter={StaticResource VisibilityConverter}}" />
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FactRow}">
                                                            <Grid MinHeight="25">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text3}"
                                                                           Margin="0,3,22,3" VerticalAlignment="Top" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap"
                                                                           Margin="0,3" VerticalAlignment="Top" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </c:WidthCap>
    </ScrollViewer>
</UserControl>
